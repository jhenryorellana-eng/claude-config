{
  "env": {
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "KIMI_PLUGIN_CC_HOOK_SCRIPT": "C:/Users/mauri/.claude/kimi-plugin-cc/approval-hook.js"
  },
  "permissions": {
    "allow": [
      "mcp__pencil"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env.local)",
      "Read(**/.env.prod.local)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Read(C:\\Users\\mauri\\.ssh\\**)",
      "Read(~/.ssh/**)",
      "Read(**/.credentials.json)",
      "Read(C:\\Users\\mauri\\.claude\\.credentials.json)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:\\Program Files\\Git\\bin\\bash.exe\" \"C:\\Users\\mauri\\claude-config\\hooks\\block-dangerous.sh\""
          }
        ]
      },
      {
        "matcher": "mcp__supabase__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:\\Program Files\\Git\\bin\\bash.exe\" \"C:\\Users\\mauri\\claude-config\\hooks\\mcp-supabase-guard.sh\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "playground@claude-plugins-official": true,
    "firecrawl@claude-plugins-official": true,
    "learning-output-style@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "supabase@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "codex@openai-codex": true,
    "kimi@kimi-marketplace": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "kimi-marketplace": {
      "source": {
        "source": "github",
        "repo": "linxule/kimi-plugin-cc"
      }
    }
  },
  "language": "español",
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "teammateMode": "in-process",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
